# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/procurement_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# 应用配置
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI服务配置
AI_PROVIDER_API_KEY=your-ai-api-key-here
AI_MODEL=gpt-4o-mini  # 或 claude-3-5-sonnet-20241022
AI_BASE_URL=https://api.openai.com/v1  # 或 https://api.anthropic.com/v1

# 应用设置
APP_NAME=智能物资采购系统
APP_VERSION=0.1.0
DEBUG=True

# CORS设置
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=True

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password